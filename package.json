{
  "name": "fotograma",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based Lottie animation editor for pixel art: import PNG layers or SVG, animate on a timeline, export Lottie JSON, .lottie or sprite sheets.",
  "license": "MIT",
  "author": "Luigy Leonardo",
  "homepage": "https://luigy23.github.io/fotograma/",
  "repository": {
    "type": "git",
    "url": "https://github.com/luigy23/fotograma.git"
  },
  "keywords": [
    "lottie",
    "animation",
    "editor",
    "pixel-art",
    "sprite-sheet",
    "bodymovin",
    "flutter",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lottie-animation-community/lottie-specs": "^0.3.2",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "lottie-web": "^5.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgpath": "^2.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
